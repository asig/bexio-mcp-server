# Server
PORT=3100
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:3100

# Global Bexio OAuth app (from developer.bexio.com) — NEVER ship to customers
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
BEXIO_OAUTH_ISSUER=https://auth.bexio.com/realms/bexio
BEXIO_REDIRECT_URI=http://localhost:3100/oauth/bexio/callback

# Space-separated scopes
BEXIO_SCOPES=openid profile email company_profile offline_access contact_edit kb_invoice_edit article_edit project_edit

# 32-byte key as 64 hex chars: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# SQLite path
DATABASE_PATH=./data/tokens.json

# Optional: require this header on /v1/token (shared with your product backend)
# BRIDGE_API_KEY=
