# Optional single-company token (stdio still requires this; HTTP can rely on Bearer only)
BEXIO_API_TOKEN=your_api_token_here
BEXIO_BASE_URL=https://api.bexio.com/2.0

# --- HTTP / multi-tenant OAuth discovery ---
# Public URL of this MCP server (no trailing slash). Set when behind a reverse proxy.
# MCP_PUBLIC_URL=https://mcp.example.com

# Bexio OpenID Connect issuer (default is correct for production Bexio)
# BEXIO_OAUTH_ISSUER=https://auth.bexio.com/realms/bexio

# Space- or comma-separated scopes advertised in Protected Resource Metadata
# BEXIO_OAUTH_SCOPES=openid profile email company_profile offline_access contact_edit kb_invoice_edit

# HTTP mode only: require "Authorization: Bearer <token>" (generate: openssl rand -hex 32)
# BEXIO_HTTP_TOKEN=
# Confine upload_file file_path / download_file output_path to this directory
# (required for local paths in HTTP mode)
# BEXIO_FILE_DIR=
